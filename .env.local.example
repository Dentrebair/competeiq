# REAL-LEAD — copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project Settings > API. Both of these are browser-visible by design; RLS is
# what protects the data, not the secrecy of the anon key. If RLS is off or a
# policy is missing, this key is a public read of the client's intelligence.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# n8n
# ---------------------------------------------------------------------------
# Shared secret sent as the x-webhook-secret header on every outbound call.
# Generate with:  openssl rand -hex 32
# The same value must be set on the n8n side, where each workflow compares it
# before doing any work. A webhook that does not check this header is an open
# endpoint that will fire Apify runs for anyone who finds the URL.
N8N_WEBHOOK_SECRET=

# Full webhook URLs from the n8n instance (n8n.srv1816291.hstgr.cloud).
# Production paths, not the /webhook-test/ ones — those only fire while the
# workflow is open in the editor and listening, which makes for a confusing
# "works on my machine" failure.
N8N_WEBHOOK_CONFIG_LOADER=
N8N_WEBHOOK_MANUAL_TRIGGER=
N8N_WEBHOOK_DIGEST=

# ---------------------------------------------------------------------------
# Anthropic
# ---------------------------------------------------------------------------
# Needed by two app-side features only: chat, and the "go deeper" analysis of a
# single alert. Both have an operator waiting on the other end, which is why they
# do not go through n8n — n8n cannot stream tokens to a browser, so routing chat
# through it means a multi-second dead wait per turn.
#
# Everything automated still calls Claude from n8n with its own key: WF-02
# interprets each signal, WF-03 writes the briefing. See docs/n8n-claude-calls.md.
#
# Leave this blank and the app still runs — the feed, briefings and competitor
# management are unaffected, and chat reports itself as unavailable rather than
# spinning.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Apify (worker service only)
# ---------------------------------------------------------------------------
# Used by process_apify_run to refetch a finished run and its dataset directly
# from the Apify API — the worker never trusts the webhook body (ADR-0005).
# Apify Console > Settings > Integrations > Personal API tokens.
APIFY_API_TOKEN=

# The web app's public base URL — NOT the worker's. /api/webhooks/apify is a
# Next.js route handler, and the worker has no HTTP server of its own; it only
# uses this to build the ad-hoc webhook's requestUrl when start_scrape starts
# a run. Apify's servers must be able to reach this URL, so a local dev value
# needs a tunnel (ngrok, Cloudflare Tunnel) — plain localhost will not work.
# Once deployed: the Next.js service's own public URL (Railway gives you one,
# or your custom domain).
APP_URL=

# A new secret distinct from N8N_WEBHOOK_SECRET — that one is for app-to-n8n
# calls and has nothing to do with this inbound Apify -> app webhook.
# Generate with:  openssl rand -hex 32
# start_scrape sends it as the x-webhook-secret header via Apify's
# headersTemplate (never in the URL); /api/webhooks/apify compares it in
# constant time before enqueuing anything.
APIFY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Pipeline database logins (supabase/07-pipeline-worker.sql)
# ---------------------------------------------------------------------------
# Supabase → Connect → Session pooler (port 5432). Use the role as the user,
# with the project ref appended, and the password you set for that role:
#
#   postgresql://pipeline_worker.<project-ref>:<password>@<pooler-host>:5432/postgres
#
# Leave out ?sslmode. TLS is set in code and verified against
# certs/supabase-ca.crt (Project Settings → Database → SSL Configuration).
#
# On Railway the worker service gets only the WORKER URL and the web service
# only the INTAKE URL. Locally both live here, because both run from one checkout.
PIPELINE_WORKER_DATABASE_URL=
PIPELINE_INTAKE_DATABASE_URL=

# ---------------------------------------------------------------------------
# Deliberately NOT here
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY
#   The app does not need it. Every write the operator makes runs through RLS
#   under their own session, which keeps RLS a live backstop instead of something
#   we routinely bypass. n8n holds the service role key in its own credential
#   store. Adding it here would put a full-database-bypass key one careless
#   import away from a client bundle.
#
# RESEND_API_KEY
#   Email is sent from n8n too.
#
# N8N_WEBHOOK_SIGNAL_PROCESSOR
#   There is no such call. WF-02 is triggered by Apify's completion webhook, not
#   by the app, and it writes straight to Supabase. The app finds out over
#   Realtime.
