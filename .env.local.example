# REAL-LEAD — copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project Settings > API. Both of these are browser-visible by design; RLS is
# what protects the data, not the secrecy of the anon key. If RLS is off or a
# policy is missing, this key is a public read of the client's intelligence.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Anthropic
# ---------------------------------------------------------------------------
# Needed by two app-side features: chat, and the "go deeper" analysis of a
# single alert. Both have an operator waiting on the other end — that's why
# they run from here rather than the worker, which is fire-and-forget.
#
# The worker also needs its own copy of this same key: process_apify_run
# (Haiku) and generate_digest (Opus) are its two Claude calls. See
# docs/n8n-claude-calls.md for both prompts (still accurate — n8n is gone, the
# worker ported them as-is).
#
# Leave this blank here and the app still runs — the feed, briefings and
# competitor management are unaffected, and chat reports itself as unavailable
# rather than spinning.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Apify (worker service only)
# ---------------------------------------------------------------------------
# Used by process_apify_run to refetch a finished run and its dataset directly
# from the Apify API — the worker never trusts the webhook body (ADR-0005).
# Apify Console > Settings > Integrations > Personal API tokens.
APIFY_API_TOKEN=

# The web app's public base URL — NOT the worker's. /api/webhooks/apify is a
# Next.js route handler, and the worker has no HTTP server of its own; it only
# uses this to build the ad-hoc webhook's requestUrl when start_scrape starts
# a run. Apify's servers must be able to reach this URL, so a local dev value
# needs a tunnel (ngrok, Cloudflare Tunnel) — plain localhost will not work.
# Once deployed: the Next.js service's own public URL (Railway gives you one,
# or your custom domain).
APP_URL=

# Generate with:  openssl rand -hex 32
# start_scrape sends it as the x-webhook-secret header via Apify's
# headersTemplate (never in the URL); /api/webhooks/apify compares it in
# constant time before enqueuing anything.
APIFY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Pipeline database logins (supabase/07-pipeline-worker.sql)
# ---------------------------------------------------------------------------
# Supabase → Connect → Session pooler (port 5432). Use the role as the user,
# with the project ref appended, and the password you set for that role:
#
#   postgresql://pipeline_worker.<project-ref>:<password>@<pooler-host>:5432/postgres
#
# Leave out ?sslmode. TLS is set in code and verified against
# certs/supabase-ca.crt (Project Settings → Database → SSL Configuration).
#
# On Railway the worker service gets only the WORKER URL and the web service
# only the INTAKE URL. Locally both live here, because both run from one checkout.
PIPELINE_WORKER_DATABASE_URL=
PIPELINE_INTAKE_DATABASE_URL=

# ---------------------------------------------------------------------------
# Deliberately NOT here
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY
#   Neither the app nor the worker needs it. The app writes through the
#   operator's own session under RLS; the worker writes as the scoped
#   pipeline_worker role (supabase/07-pipeline-worker.sql). Adding the service
#   role key here would put a full-database-bypass key one careless import
#   away from a client bundle.
#
# RESEND_API_KEY
#   Email delivery was out of scope for the n8n migration (see "Out of Scope"
#   in docs/app-intelligence-migration-spec.md) — it isn't part of this app.
#
# N8N_*
#   n8n is fully retired (docs/adr/0003-0006). Nothing in this codebase calls
#   it anymore — Processing, Scheduling and Digest all moved into worker/ and
#   app/actions/.
